# .env.example
# 
# Copiar para .env.local e preencher com valores reais
# NUNCA commitar .env com valores reais!
#
# cp .env.example .env.local
# export $(cat .env.local | xargs)

# ============ Configuração Global ============
ENVIRONMENT=dev
LOG_LEVEL=DEBUG
AWS_REGION=us-east-1
SERVICE_VERSION=1.0.0

# ============ DynamoDB ============
CATEGORIZATIONS_TABLE=GestaoFinanceira-Categorizacoes-dev
TRANSACTIONS_TABLE=GestaoFinanceira-Transacoes-dev

# ============ External Services ============
CATEGORIZER_ENDPOINT=https://api-dev.categorizer.example.com/api/v1/categorize
CATEGORIZER_TOKEN=seu-token-dev-aqui-123456

# ============ AWS Credentials (se local) ============
# Usar: aws configure ou AWS_PROFILE
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=xxx...
# AWS_SESSION_TOKEN=xxx... (se usar STS)

# ============ Development ============
PYTEST_ADDOPTS=-v --tb=short
